# MongoDB Atlas connection string (required)
MONGODB_URI=

# Session signing secret, 32+ random characters (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=
# Optional legacy alias (used only if ADMIN_SESSION_SECRET is empty)
NEXTAUTH_SECRET=

# First-run owner account. On the very first login (no admins in the DB yet) this account
# is created with a bcrypt-hashed password. Change the password afterwards in Admin > Settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments (optional). Without keys, orders are saved as "awaiting payment".
# Credit/debit cards via Stripe -> paid out to the client's Stripe-linked bank account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PayPal (developer.paypal.com > Apps & Credentials, from the client's PayPal Business account).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for real payments
PAYPAL_ENV=sandbox

# Email notifications (contact form + orders). Use Resend OR SMTP.
RESEND_API_KEY=
# Sender, e.g. "Magnetify <orders@magnetify.ca>" (domain must be verified in Resend)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where admin notifications go (defaults to the contact email in Admin > Settings)
NOTIFY_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
