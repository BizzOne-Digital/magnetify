# MongoDB Atlas connection string (required)
MONGODB_URI=

# Session signing secret, 32+ random characters (required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=
# Optional legacy alias (used only if ADMIN_SESSION_SECRET is empty)
NEXTAUTH_SECRET=

# First-run owner account. On the very first login (no admins in the DB yet) this account
# is created with a bcrypt-hashed password. Change the password afterwards in Admin > Settings.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (optional). Without these, orders are saved as "awaiting payment".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
